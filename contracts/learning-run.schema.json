{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://via-decide/kup-curriculum/contracts/learning-run.schema.json",
  "title": "LearningRun",
  "description": "One weekly cross-domain bridge experiment: CONCEPT -> REPRESENTATION -> PHYSICAL INTERPRETATION -> WORKED EXAMPLE -> SIMULATION -> MEASUREMENT/EXPERIMENT -> CROSS-DOMAIN BRIDGES -> KUP/GLOBERAG RELEVANCE -> UNRESOLVED QUESTION.",
  "type": "object",
  "required": [
    "runId", "date", "conceptRef", "status", "representation",
    "physicalInterpretation", "workedExample", "crossDomainBridges",
    "kupRelevance", "unresolvedQuestion"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string", "pattern": "^run_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9_]+$" },
    "date": { "type": "string", "format": "date" },
    "conceptRef": { "type": "string", "pattern": "^concept_[a-z0-9_]+$" },
    "status": {
      "type": "string",
      "enum": ["PLANNED", "IN_PROGRESS", "COMPLETE", "BLOCKED"]
    },
    "representation": { "type": "string", "minLength": 1 },
    "physicalInterpretation": { "type": "string", "minLength": 1 },
    "workedExample": { "type": "string", "minLength": 1 },
    "simulation": {
      "type": "object",
      "properties": {
        "performed": { "type": "boolean" },
        "artifactRef": { "type": ["string", "null"] }
      }
    },
    "measurementOrExperiment": {
      "type": "object",
      "properties": {
        "performed": { "type": "boolean" },
        "evidenceRef": { "type": ["string", "null"] }
      }
    },
    "crossDomainBridges": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "minItems": 3,
      "description": "domainId values this run actually crossed. Issue #17 requires each weekly run cross at least three fields -- fewer than 3 means this isn't a bridge run."
    },
    "kupRelevance": { "type": "string", "minLength": 1 },
    "unresolvedQuestion": {
      "type": "string",
      "minLength": 1,
      "description": "Required, not optional -- a run with no unresolved question is claiming false completeness (issue #17 risk 3)."
    }
  }
}
